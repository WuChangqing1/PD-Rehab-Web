  "components": {
    "schemas": {
      "CreateRecording": {
        "properties": {
          "client_capture_id": {
            "type": "string",
            "format": "uuid",
            "title": "Client Capture Id"
          },
          "device_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Device Id"
          },
          "local_profile_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Local Profile Id"
          },
          "patient_id": {
            "type": "string",
            "format": "uuid",
            "title": "Patient Id"
          },
          "external_record_id": {
            "type": "string",
            "format": "uuid",
            "title": "External Record Id"
          },
          "consent_version": {
            "type": "string",
            "pattern": "^face-capture-v1$",
            "title": "Consent Version"
          },
          "agreed_at_ms": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Agreed At Ms"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/VideoFile"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Files"
          },
          "timeline": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 10000,
            "title": "Timeline"
          }
        },
        "type": "object",
        "required": [
          "client_capture_id",
          "device_id",
          "local_profile_id",
          "patient_id",
          "external_record_id",
          "consent_version",
          "agreed_at_ms",
          "files"
        ],
        "title": "CreateRecording"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Review": {
        "properties": {
          "candidate_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "review_confirmed": {
            "type": "boolean",
            "title": "Review Confirmed",
            "default": false
          },
          "reject": {
            "type": "boolean",
            "title": "Reject",
            "default": false
          }
        },
        "type": "object",
        "title": "Review"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VideoFile": {
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid",
            "title": "File Id"
          },
          "sequence": {
            "type": "integer",
            "maximum": 99.0,
            "minimum": 0.0,
            "title": "Sequence"
          },
          "size_bytes": {
            "type": "integer",
            "maximum": 419430400.0,
            "exclusiveMinimum": 0.0,
            "title": "Size Bytes"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256"
          },
          "chunk_count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Chunk Count"
          },
          "mime_type": {
            "type": "string",
            "pattern": "^video/mp4$",
            "title": "Mime Type"
          },
          "duration_ms": {
            "type": "integer",
            "maximum": 1800000.0,
            "exclusiveMinimum": 0.0,
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "file_id",
          "sequence",
          "size_bytes",
          "sha256",
          "chunk_count",
          "mime_type",
          "duration_ms"
        ],
        "title": "VideoFile"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
