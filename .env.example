# ============================================================
# PD-Rehab-Web  .env.example
# 复制为 .env 后按需修改。.env 绝对不得提交到 Git。
# ============================================================
# 医疗声明：本系统用于科研、辅助评估及康复训练展示，
# 不能替代专业医生诊断和标准临床量表。
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_NAME=PD-Rehab-Web
# 前端开发服务器地址（CORS 白名单，逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 日志级别
LOG_LEVEL=INFO

# ---------- 数据库 ----------
# 开发：SQLite。生产可切换 MySQL：mysql+pymysql://user:pass@host:3306/pd_rehab?charset=utf8mb4
DATABASE_URL=sqlite:///./data/pd.db
# SQL 回显（调试用，生产必须 false）
DB_ECHO=false

# ---------- 认证 ----------
# 必须修改！生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- 文件存储 ----------
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
REPORT_DIR=./data/reports
# 单文件上传上限（MB）
MAX_UPLOAD_SIZE_MB=500
# 允许的视频扩展名
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi

# ---------- 模型：老师微表情 / PD 辅助识别 ----------
# 留空 = MODEL_NOT_CONFIGURED。禁止在未配置时伪造模型输出。
MICRO_EXPRESSION_MODEL_DIR=
# 可选：显式指定推理入口模块（留空则自动探测）
MICRO_EXPRESSION_ENTRY=
# 可选：显式指定 checkpoint 文件名（留空则自动探测 *.pt / *.pth / *.ckpt）
MICRO_EXPRESSION_CHECKPOINT=
# 可选：cuda / cpu（留空则自动）
MICRO_EXPRESSION_DEVICE=

# ---------- 模型：Finger Tapping 外部算法仓库 ----------
FINGER_TAPPING_REPO_DIR=D:/CodingData/Github/VideoBased-PD-Biomarkers
# MediaPipe HandLandmarker 模型文件。
# 留空时按以下顺序回退：
#   1) ./models/mediapipe/hand_landmarker.task
#   2) <FINGER_TAPPING_REPO_DIR>/src/demo/hand_landmarker.task
#   3) 从 MediaPipe 官方地址下载（需要网络）
# sha256 应为 fbc2a30080c3c557093b5ddfc334698132eb341044ccee322ccf8bcf3607cde1
HAND_LANDMARKER_PATH=

# ---------- 推理设备 / 并发 ----------
USE_GPU=true
# GPU（或 CPU）推理并发数。为避免显存/内存 OOM，默认 1，不建议修改。
GPU_INFERENCE_CONCURRENCY=1
# CPU 推理线程数上限（服务器 4 vCPU 时建议 2）
TORCH_NUM_THREADS=4

# ---------- Demo / Mock ----------
# 默认 false。只有显式设为 true 才允许 Mock，且页面必须标记 DEMO DATA。
DEMO_MOCK_MODE=false

# ---------- 指标与算法版本（写入结果的 algorithm_version 字段）----------
FT_FEATURE_ALGORITHM_VERSION=ft-features-v1.0.0
FT_QC_ALGORITHM_VERSION=ft-qc-v1.0.0
FT_COMPARE_ALGORITHM_VERSION=ft-compare-v1.0.0
PIANO_METRICS_VERSION=piano-metrics-v1.0.0
PIANO_DIFFICULTY_VERSION=piano-difficulty-v1.0.0
POSE_METRICS_VERSION=pose-metrics-v1.0.0
FEATURE_SCHEMA_VERSION=1.0

# ---------- Finger Tapping 可调阈值（必须入库到 analysis_config_json 以保证可复现）----------
# 归一化方式：PALM_REFERENCE（wrist -> INDEX_FINGER_MCP）
FT_NORMALIZATION_METHOD=PALM_REFERENCE
# 滤波
FT_FILTER_METHOD=BUTTERWORTH
FT_FILTER_ORDER=4
FT_FILTER_CUTOFF_HZ=9.0
# 峰谷检测
FT_PEAK_DISTANCE=5
FT_PEAK_HEIGHT_FACTOR=0.5
FT_PEAK_PROMINENCE_FACTOR=0.5
# 中断判定：cycle_duration > factor * median(cycle_duration)
FT_INTERRUPTION_THRESHOLD_FACTOR=1.5
FT_INTERRUPTION_THRESHOLD_BASIS=median_cycle_duration
# 质量控制门限
FT_MIN_VALID_FRAME_RATIO=0.5
FT_MIN_CYCLE_COUNT=2
FT_MIN_DURATION_SEC=3.0
# 最短帧数 = FT_MIN_FRAMES_PER_FPS * fps
FT_MIN_FRAMES_PER_FPS=4

# ---------- 管理员工号（首次启动自动创建，仅供本地/Demo 使用）----------
# 生产环境请改为强密码并在首次登录后修改
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
