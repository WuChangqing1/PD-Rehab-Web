# ============================================================
# PD-Rehab-Web  .gitignore
# 帕金森病智能辅助识别、运动状态量化与数字康复训练平台
# ============================================================
# 绝对禁止提交：真实患者视频、真实身份信息、医院私有数据、
# 老师模型权重、私有 checkpoint、.env、JWT Secret、
# SQLite 数据库、MySQL dump、上传/输出/报告目录。
# ============================================================

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
secret/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.python-version

# ---------- 虚拟环境 ----------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.pdm-python
.pixi/
uv.lock

