models/micro_expression/
models/private/
private_models/
checkpoints/
weights/

# ---------- 医学影像 / 视频 / 音频 ----------
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.dcm
*.nii
*.nii.gz
!data/demo/.gitkeep
# Phase 0 环境审计的机器可读产物（不含任何患者数据，可安全入库）
!data/demo/phase0_probe.json

# ---------- 日志 ----------
logs/
*.log
*.log.*
log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

