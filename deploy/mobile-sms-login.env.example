# 2026-11-13 SMS-only release. Merge these entries into the existing backend environment.
# Preserve existing DATABASE_URL/JWT/other configuration. Never commit real keys.
# Fill credentials first, then change MOBILE_SMS_ENABLED to true and restart the backend.
MOBILE_SMS_ENABLED=false
MOBILE_SMS_ACCESS_KEY_ID=
MOBILE_SMS_ACCESS_KEY_SECRET=
MOBILE_SMS_SIGN_NAME=恒创联众
MOBILE_SMS_TEMPLATE_CODE=100001
MOBILE_SMS_SCHEME_NAME=
# Fixed window: up to 100 send reservations across the service per 24 hours.
# This is a local request limit, not a prepaid SMS package or a billing cap.
MOBILE_SMS_DAILY_BUDGET=100

# Individual operator cannot enable the required WeChat capability for now.
MOBILE_WECHAT_ENABLED=false
MOBILE_WECHAT_APP_ID=
MOBILE_WECHAT_APP_SECRET=
