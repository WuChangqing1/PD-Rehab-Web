# Add these variables to the existing BACKEND environment; keep existing JWT/DB settings.
# Enable SMS after server credentials are configured. Keep WeChat disabled for this release.
MOBILE_WECHAT_ENABLED=false
MOBILE_WECHAT_APP_ID=
MOBILE_WECHAT_APP_SECRET=

# Alibaba Cloud PNVS SMS Authentication, not the separate dysmsapi SMS product.
MOBILE_SMS_ENABLED=false
MOBILE_SMS_ACCESS_KEY_ID=
MOBILE_SMS_ACCESS_KEY_SECRET=
MOBILE_SMS_SIGN_NAME=
MOBILE_SMS_TEMPLATE_CODE=
# Optional; blank uses the provider's default scheme. Send/check must use the same scheme.
MOBILE_SMS_SCHEME_NAME=
# Global SEND reservations per fixed 24-hour window from first request; failed sends count.
MOBILE_SMS_DAILY_BUDGET=100
